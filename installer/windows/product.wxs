<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- ProductVersion is passed by build-msi.ps1 (from dist.py, which reads
       APP_VERSION out of src/app_info.py). -->
  <Product Id="*" Name="PlayForm" Language="1033" Version="$(var.ProductVersion)"
           Manufacturer="Joybytes" UpgradeCode="78a1de45-299d-4be2-810c-d409c5db1ebc">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser"
             Description="PlayForm - Media Player by Joybytes"
             Comments="A modern, accessible media player for audio and video files." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of PlayForm is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Feature tree: Licence Agreement, then the Customize page where the
         user picks feature and (through WIXUI_INSTALLDIR) install folder. -->
    <UIRef Id="WixUI_FeatureTree" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- Optional: uncomment to add branding bitmaps
    <WixVariable Id="WixUIBannerBmp" Value="installer\windows\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="installer\windows\dialog.bmp" /> -->

    <Property Id="APPLICATIONFOLDER">
      <RegistrySearch Id="ApplicationFolderRegistry" Root="HKCU"
                      Key="Software\Joybytes\PlayForm" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="MainFeature" Title="PlayForm" Level="1" Absent="disallow"
             Description="The application itself.">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentRef Id="InstallDirRegistration" />
    </Feature>

    <Feature Id="StartMenuShortcutFeature" Title="Start Menu shortcut" Level="1"
             Description="Add a PlayForm shortcut to the Start Menu.">
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="1"
             Description="Add a PlayForm shortcut to the desktop.">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Feature Id="FileAssociationsFeature" Title="File associations" Level="1"
             Description="Open the audio and video formats the app supports with PlayForm from Explorer.">
      <ComponentRef Id="FileAssociations" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="Joybytes" />
      </Directory>

      <!-- Uncomment for system-wide install (requires elevation):
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="PlayForm" />
      </Directory> -->

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="PlayForm" />
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="ab34c051-88ed-4258-a973-cfc972e0bbb4">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="PlayForm"
                  Description="PlayForm - Media Player"
                  Target="[INSTALLFOLDER]PlayForm.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PlayForm.exe" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Joybytes\PlayForm"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="1a3e9ba3-3777-4c1f-8ee2-615cc23c3bd5">
        <Shortcut Id="DesktopApplicationShortcut"
                  Name="PlayForm"
                  Description="PlayForm - Media Player"
                  Target="[INSTALLFOLDER]PlayForm.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PlayForm.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Joybytes\PlayForm"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Remembers where the app went so upgrades and maintenance runs can
           find it again. -->
      <Component Id="InstallDirRegistration" Guid="a1bc5585-319e-481e-b498-14b1d31f4f83">
        <RegistryValue Root="HKCU"
                       Key="Software\Joybytes\PlayForm"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RemoveFolder Id="INSTALLFOLDER" On="uninstall" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <?include file_associations.wxi?>

  <Fragment>
    <Icon Id="PlayForm.exe" SourceFile="PlayForm.exe" />
    <Property Id="ARPPRODUCTICON" Value="PlayForm.exe" />

    <Property Id="ARPCOMMENTS"    Value="A modern, accessible media player for audio and video files." />
    <Property Id="ARPCONTACT"     Value="support@joybytes.dev" />
    <Property Id="ARPHELPLINK"    Value="https://joybytes.dev" />
    <Property Id="ARPURLINFOABOUT" Value="https://joybytes.dev" />
    <Property Id="ARPNOREPAIR"    Value="1" />
  </Fragment>
</Wix>
